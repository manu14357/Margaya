{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "launcher",
	"description": "The bundled launcher (the server list and settings). Quick add, search and Today have their own capabilities.",
	"windows": ["main"],
	"permissions": [
		"core:default",
		"allow-list-servers",
		"allow-discover-server",
		"allow-add-server",
		"allow-rename-server",
		"allow-remove-server",
		"allow-open-server",
		"allow-start-sign-in",
		"allow-submit-sign-in-code",
		"allow-cancel-sign-in",
		"allow-sign-out",
		"allow-open-external",
		"allow-take-launcher-prompt",
		"allow-get-settings",
		"allow-set-autostart",
		"allow-copy-diagnostics",
		"allow-check-for-update",
		"allow-install-update",
		"allow-set-start-minimized",
		"allow-get-shortcuts",
		"allow-set-shortcut",
		"allow-reset-shortcut",
		"allow-pause-shortcuts",
		"allow-set-update-channel",
		"allow-whats-new-state",
		"allow-dismiss-whats-new",
		"allow-release-notes",
		"allow-get-offline-reading",
		"allow-set-offline-reading",
		"allow-clear-offline-copies",
		"allow-get-spellcheck",
		"allow-set-spellcheck",
		"allow-get-notification-pause",
		"allow-set-notification-pause"
	]
}
