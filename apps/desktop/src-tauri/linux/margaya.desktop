[Desktop Entry]
Type=Application
Name={{name}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %u
Icon={{icon}}
Terminal=false
Categories=Office;ProjectManagement;
StartupWMClass={{exec}}
{{#if mime_type}}
MimeType={{mime_type}};
{{/if}}
Actions=quick-add;search;files;inbox;my-tasks;

[Desktop Action quick-add]
Name=Quick add
Exec={{exec}} --action=quick-add

[Desktop Action search]
Name=Search
Exec={{exec}} --action=search

[Desktop Action files]
Name=Files
Exec={{exec}} --action=files

[Desktop Action inbox]
Name=Inbox
Exec={{exec}} --open=inbox

[Desktop Action my-tasks]
Name=My tasks
Exec={{exec}} --open=my-tasks
