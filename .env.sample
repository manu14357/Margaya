# General URLs
MARGAYA_CLIENT_URL=http://localhost:5173
# MARGAYA_API_URL=http://localhost:1337      # optional - defaults to MARGAYA_CLIENT_URL/api
# MARGAYA_INTERNAL_API_URL=http://127.0.0.1:1337 # optional - internal MCP tool requests only
# CORS_ORIGINS=                            # optional - comma-separated; defaults to MARGAYA_CLIENT_URL
# MARGAYA_PUBLIC_SITE_URL=https://margaya.app # optional - public website the app links to; docs are at <url>/docs (web container; VITE_PUBLIC_SITE_URL for vite dev)
# MARGAYA_SOURCE_URL=https://github.com/manu14357/Margaya # optional - the Help menu's Source code link (AGPL-3.0); point it at your repository if you run changed code

# Database
# DATABASE_URL=                            # optional: use this for host-native or external DB access
POSTGRES_DB=margaya
POSTGRES_USER=margaya
POSTGRES_PASSWORD=
# POSTGRES_HOST=postgres                   # Compose container default; use localhost for host-native API startup
# POSTGRES_PORT=5432
# Note: POSTGRES_DB and POSTGRES_USER alone do not enable derived connection mode.
# Derived DATABASE_URL is only used when POSTGRES_PASSWORD or an explicit host/port is set.
# DATABASE_POOL_MAX=10                     # connections per API instance; instances x this must fit max_connections
# DATABASE_STATEMENT_TIMEOUT_MS=300000     # longest a query may run (ms); 0 = the server's setting; migrations have no limit

# Redis Pub/Sub for WebSockets (Optional) -> auto fallback to in memory
# Only one mode should be configured. Priority: Cluster > Sentinel > Standalone.

# Standalone
#REDIS_URL=

# Sentinel
#REDIS_SENTINELS=
#REDIS_SENTINEL_MASTER_NAME=mymaster
#REDIS_SENTINEL_PASSWORD=
#REDIS_SENTINEL_TLS=false

# Cluster
#REDIS_CLUSTER_NODES=

# Shared (Sentinel & Cluster)
#REDIS_PASSWORD=

# Authentication
# Signs sessions and encrypts the SMTP passwords, OAuth secrets, AI keys and
# webhook signing secrets saved in the app. Generate with: openssl rand -hex 32
# Bundled image only: if blank, one is generated once and saved as .auth-secret
# in the uploads volume (MARGAYA_STORAGE_DIR). Without a writable volume, a
# warning says saved secrets will be lost. The separate API image and running
# from source refuse to start without it.
AUTH_SECRET=

# Requests per minute for each API key (default 600; 0 disables the limit).
# Counted per API instance.
#API_KEY_RATE_LIMIT_PER_MINUTE=600

# Encrypts secrets users save in notification settings (webhook signing
# secrets, ntfy and Gotify tokens). Generate with: openssl rand -hex 32
# Without it, saving such a secret is refused (503). Keep it stable.
#NOTIFICATION_SECRET_ENCRYPTION_KEY=

# Web push: alerts on phones and computers from the installed app or browser.
# Off until both keys are set. Generate them once with
#   pnpm --filter @margaya/api admin generate-push-keys
# (in the Docker image: node apps/api/dist/cli/admin.js generate-push-keys).
# Keep them stable: new keys turn push off on every device until people turn it
# on again. VAPID_SUBJECT is a contact for push services, a mailto: address
# you read or an https:// URL; it defaults to MARGAYA_CLIENT_URL when that is
# https://. The API warns at startup while it's an example address like the
# one below, which Apple's push service may refuse.
#VAPID_PUBLIC_KEY=
#VAPID_PRIVATE_KEY=
#VAPID_SUBJECT=mailto:admin@example.com

# Seconds email notifications wait so several are sent as one email per
# person (default 300). 0 sends each notification immediately. Other
# channels (in-app, ntfy, Gotify, webhooks) are never delayed.
#EMAIL_NOTIFICATION_BATCH_WINDOW_SECONDS=300

# Trash: days a deleted task or project stays restorable before an hourly job
# deletes it permanently (default 30). 0 turns the automatic purge off.
#TRASH_RETENTION_DAYS=30

# Task exports: days a finished export file stays downloadable (1-30, default 7).
# Files go to S3 storage when it is configured, otherwise to the database (25 MB max).
#EXPORT_RETENTION_DAYS=7

# Workspace webhooks: days the delivery log is kept (1-90, default 14).
# Webhook signing secrets are encrypted with a key derived from AUTH_SECRET:
# changing AUTH_SECRET makes them unreadable until each webhook's secret is rotated.
#WEBHOOK_DELIVERY_RETENTION_DAYS=14

# Workspace audit log: days entries are kept (default 365; 0 keeps them forever).
#AUDIT_LOG_RETENTION_DAYS=365

# GitHub SSO (Sign in with GitHub, OAuth App)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Legacy fallback for SSO (used only if GITHUB_OAUTH_* are unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub integration (GitHub App: repository sync, webhooks)
GITHUB_APP_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=

# SMTP Configuration
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REQUIRE_TLS=
# When SMTP is configured, sign-in uses email verification codes by default.
# Set to true to use email/password sign-in instead (invitations still use SMTP).
#DISABLE_EMAIL_OTP_SIGN_IN=false

# Email intake (optional): incoming mail becomes Intake requests. Each
# project gets requests+<token>@your-domain. Poll a mailbox over IMAP (works
# behind a VPN) and/or accept a mail provider's webhook at
# /api/intake-email/inbound. See docs: core/installation/email-intake.
#INTAKE_EMAIL_ADDRESS=requests@example.com
#INTAKE_IMAP_HOST=
#INTAKE_IMAP_PORT=993
#INTAKE_IMAP_SECURITY=tls
#INTAKE_IMAP_USER=
#INTAKE_IMAP_PASSWORD=
#INTAKE_IMAP_FOLDER=INBOX
#INTAKE_EMAIL_WEBHOOK_SECRET=
#INTAKE_EMAIL_MAX_BYTES=26214400
#INTAKE_EMAIL_MAX_ATTACHMENT_BYTES=10485760
#INTAKE_EMAIL_MAX_ATTACHMENTS=10

# Published project boards. Set to true to turn every public board off
# (links answer 404, publishing answers 409); publications are kept.
#DISABLE_PUBLIC_BOARDS=false

# Instance settings. Instance admins can change sign-up, sign-in, OAuth, SMTP,
# workspace creation and public board settings in Settings > Instance. A
# variable set here (not blank) always wins and locks that setting in the
# panel; OAuth providers and SMTP lock as a group from their client id or
# SMTP_HOST. Stored secrets are encrypted with a key derived from AUTH_SECRET.
# Name shown on the sign-in screen and on public boards (default Margaya).
#MARGAYA_INSTANCE_NAME=Margaya
# Product landing page for signed-out visitors at the web app's root (default
# true). Set to false to send them straight to sign-in.
#MARGAYA_PUBLIC_LANDING=true
# In-app feedback (Send feedback and the optional survey), kept on this server
# for its admins (default true). Set to false to turn it off.
#MARGAYA_FEEDBACK_ENABLED=true
# Set to true to ignore saved values and make the panel read-only.
#MARGAYA_LOCK_INSTANCE_SETTINGS=false

# Sign-in rate limiting (on by default): per client IP, limits sign-in,
# email codes, magic links and password reset/change. Counts are kept in
# memory per API instance and reset on restart. Behind a reverse proxy, set
# TRUSTED_PROXIES so each client is counted by its own IP.
#AUTH_RATE_LIMIT_ENABLED=true

# Cloud-mode abuse mitigations (only enable on hosted multi-tenant instances).
# When MARGAYA_CLOUD=true: signup with disposable-email providers is blocked,
# Turnstile is required on /sign-up/email, guest accounts cannot send
# workspace invites, and per-IP rate limits apply to signup + invite paths.
#MARGAYA_CLOUD=false

# Cloudflare Turnstile (signup captcha). Set the secret key to enforce;
# leave unset to skip verification (self-hosted).
#TURNSTILE_SECRET_KEY=
# Web container: the production image bakes "MARGAYA_TURNSTILE_SITE_KEY" as a
# placeholder and apps/web/env.sh substitutes it at container start from this
# env var. For local dev (vite), set VITE_TURNSTILE_SITE_KEY in apps/web/.env.
#MARGAYA_TURNSTILE_SITE_KEY=

# Sentry error tracking (Optional): errors are only reported when a DSN is set
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1         # 0.0 disables; default 0 (opt-in)
# SENTRY_PROFILES_SAMPLE_RATE=0.1      # 0.0 disables; default 0 (opt-in)
# SENTRY_RELEASE=                       # git SHA; ties events to source maps. Falls back to package.json version.
# SENTRY_API_TOKEN=                     # Used by scripts/provision-sentry-alerts.sh and scripts/provision-sentry-dashboards.sh. Scope: org:write. https://sentry.io/settings/account/api/auth-tokens/

# Monitoring (Optional, all off by default). See the "Monitoring" docs page.
# Prometheus metrics need MARGAYA_METRICS_ENABLED=true plus a token
# (GET /api/metrics with "Authorization: Bearer <token>", 16+ characters) or a
# separate port (GET /metrics on MARGAYA_METRICS_PORT, inside your network).
# MARGAYA_METRICS_ENABLED=true
# MARGAYA_METRICS_TOKEN=
# MARGAYA_METRICS_PORT=9464
# MARGAYA_METRICS_HOST=0.0.0.0
# One JSON line per request (request ID, method, route template, status, time).
# MARGAYA_ACCESS_LOG=true
# json writes every log line as a JSON object; text (default) keeps plain lines.
# MARGAYA_LOG_FORMAT=json
# Daily check for a newer release, shown to instance admins. Sends nothing
# about this instance. Setting it locks the switch in Instance > Health.
# MARGAYA_UPDATE_CHECK=true

# Margaya Cloud billing via Creem (Optional): only active when MARGAYA_CLOUD=true
# and both keys are set. Self-hosted installs leave these empty; billing stays off.
# CREEM_API_KEY=
# CREEM_WEBHOOK_SECRET=
# CREEM_TEST_MODE=true                     # use Creem's sandbox API
# CREEM_PRODUCT_PERSONAL_MONTHLY=
# CREEM_PRODUCT_PERSONAL_ANNUAL=
# CREEM_PRODUCT_TEAM_MONTHLY=
# CREEM_PRODUCT_TEAM_ANNUAL=
# BILLING_TRIAL_DAYS=14
# BILLING_FOUNDING_CUTOFF=                 # ISO date; workspaces created on/before keep free access
