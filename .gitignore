# Dependencies
node_modules
.pnp
.pnp.js

# Local env files. Only the documented templates are shared: the root sample
# and the web app's committed Vite defaults (.env.production holds placeholders
# that env.sh replaces at container start).
.env
.env.*
!.env.sample
!.env.example
!apps/web/.env.development
!apps/web/.env.production

# Testing
coverage

# Turbo
.turbo

# Vercel
.vercel

# Build outputs
.next/
out/
build
dist
.source

# "build" above matches any dir named build; keep this source directory tracked
!apps/web/src/components/ai/build/

# Next.js generated types
next-env.d.ts

# Debug and logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

